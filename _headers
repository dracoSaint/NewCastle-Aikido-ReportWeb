# Cloudflare Pages response headers (copied into dist/ by `npm run build`).
# SAMEORIGIN, not DENY: the SOP Library shows documents in its own iframe.
# CSP: scripts only from this site + jsdelivr (supabase-js, Chart.js); no inline scripts or on*="" handlers.
# Inline styles stay allowed (JS sets style attributes). New outside source? Add it here, then test with `npm run preview`.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://knnzybqudpdxhddcaxcv.supabase.co wss://knnzybqudpdxhddcaxcv.supabase.co https://docs.google.com https://*.googleusercontent.com; frame-src https://docs.google.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'
